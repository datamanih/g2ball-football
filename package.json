{
  "name": "g2ball-football",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "simulate": "evenhub-simulator http://localhost:5173",
    "qr": "evenhub qr --port 5173",
    "pack": "npm run build && evenhub pack app.json dist -o g2ball-football-0.7.1-beta.ehpk",
    "test": "vite-node src/selftest.ts"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "*",
    "@evenrealities/evenhub-simulator": "*",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-node": "^6.0.0"
  }
}